# Copy to .env and adjust. Never commit real keys.

# Async SQLAlchemy URL. Matches the Postgres service in ../docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/exportdb

# "dev" enables SQL echo logging.
ENV=dev

# Optional. Leave empty to run offline: the classifier then returns UNKNOWN and
# every new product goes to manual review until a code is supplied via /feedback.
OPENAI_API_KEY=

# Optional. Text file with one denied party per line (e.g. an export of the EU
# consolidated list). Without it a small built-in sample list is used.
# DENIED_PARTIES_FILE=
