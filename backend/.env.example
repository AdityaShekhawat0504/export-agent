# Copy to .env and adjust. Never commit real keys.

# Async SQLAlchemy URL. Matches the Postgres service in ../docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/exportdb

# "dev" enables SQL echo logging.
ENV=dev

# Optional. Leave empty to run offline: the classifier then returns a fixed
# fallback HS code (8501.10, confidence 0.82) instead of calling OpenAI.
OPENAI_API_KEY=
